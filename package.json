{
  "name": "books-to-arabic",
  "version": "0.2.0",
  "private": true,
  "description": "A multi-book repository of Arabic educational adaptations with a reproducible RTL PDF build per book project",
  "type": "module",
  "engines": {
    "node": ">=22.17.0"
  },
  "scripts": {
    "books": "python3 scripts/build_book.py --list",
    "build": "python3 scripts/build_book.py --book",
    "check": "python3 scripts/build_book.py --book how-linux-works-ar --check --verify-source",
    "test": "python3 -m unittest discover -s tests -v"
  },
  "dependencies": {
    "@sparticuz/chromium": "149.0.0",
    "pagedjs": "0.4.3",
    "playwright-core": "1.63.0"
  }
}
